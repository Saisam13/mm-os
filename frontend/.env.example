# Copy to .env.local for local development.

# When true, the API layer serves fixture data from src/api/mock.ts instead of
# calling a real backend. Dev-only: read once in src/api/index.ts, and the
# mock module is never imported when `import.meta.env.PROD` is true.
VITE_USE_MOCK=true

# Only used when VITE_USE_MOCK=false. Leave blank to call same-origin /api
# (the Vite dev server proxies /api to http://localhost:8000, see vite.config.ts).
VITE_API_BASE=
