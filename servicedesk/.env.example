# Service Desk environment. Copy to servicedesk/.env and fill in for a real deployment.
# Own database — never MMOS_DATABASE_URL, never the `mmos` database.
DATABASE_URL=postgresql+psycopg://servicedesk:CHANGE_ME@postgres:5432/servicedesk

MMOS_OS_URL=https://os.m-mines.com
MMOS_SERVICE_SLUG=servicedesk
MMOS_SERVICE_KEY=
MMOS_ISSUER=https://os.m-mines.com

# "http" once packages/mmos-client-py exists and MM OS is reachable; "stub" is what every
# test in this repo runs against. See app/mmos_seam.py.
AUTH_MODE=stub
DEV_SECRET=CHANGE_ME

# "http" once the org-chain lookup this service needs exists on MM OS (it does not yet —
# see handoff/a5-servicedesk.md's Contract objections). "seed" is a tiny local fixture.
ORG_CHART_MODE=seed

# Outbound mail (Workspace SMTP) — same variables as deploy/.env.example.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=itadmin@m-mines.com
SMTP_PASSWORD=
