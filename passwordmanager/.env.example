# Password Manager environment. Copy to passwordmanager/.env and fill in for a real
# deployment. This shell stores no secrets, so DATABASE_URL is unused today — see
# SECURITY.md and app/config.py.
DATABASE_URL=sqlite:///./passwordmanager.db

MMOS_OS_URL=https://os.m-mines.com
MMOS_SERVICE_SLUG=passwordmanager
MMOS_SERVICE_KEY=
MMOS_ISSUER=https://os.m-mines.com

# "http" once packages/mmos-client-py exists and MM OS is reachable; "stub" is what every
# test in this repo runs against, and local dev only. See app/mmos_seam.py and app/main.py's
# boot guard, which refuses to start with ENVIRONMENT=production and AUTH_MODE=stub.
ENVIRONMENT=development
AUTH_MODE=stub
DEV_SECRET=CHANGE_ME
