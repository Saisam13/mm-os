# ============================================================================
# MM OS — PRODUCTION environment (the post-demo revert config).  SEC-4.
# ============================================================================
#
# The live demo (see RESUME.md "LIVE DEMO" + "MUST be reverted after the meeting")
# was deployed with a DELIBERATELY WEAKENED posture so it could be reached from
# anywhere: MMOS_NETWORK_MODE=public, MMOS_COOKIE_SECURE possibly false, all demo
# PINs = 1234, and backend/app/demo_seed.py carrying 23 real employee names.
#
# THIS FILE is the hardened target to revert to for a real rollout. Copy it to
# deploy/.env (NEVER commit deploy/.env — it is gitignored), fill in every value
# marked CHANGE_ME / <...>, and confirm each of the "revert checklist" items at the
# bottom. Nothing here is secret as written; the secrets are the values you fill in.
#
# Do NOT run this against the live VPS blind — read docs/06-network-security.md and
# docs/10-runbook.md §1 first, and take a backup before flipping network mode.

# ── identity of this deployment ─────────────────────────────────────────────
MMOS_ISSUER=https://os.m-mines.com
MMOS_ENVIRONMENT=production
MMOS_VERSION=1.0.0

# ── database ────────────────────────────────────────────────────────────────
# Under deploy/docker-compose.yml the api container's MMOS_DATABASE_URL is built
# from POSTGRES_PASSWORD automatically (host `postgres`, not localhost). This line
# only matters when running the API directly against a local Postgres.
MMOS_DATABASE_URL=postgresql+psycopg://mmos:CHANGE_ME@localhost:5432/mmos
POSTGRES_PASSWORD=CHANGE_ME

# ── network posture — THE key revert (docs/06-network-security.md) ───────────
# private = office LAN + WireGuard only, enforced by the NetworkGate middleware
# against MMOS_ALLOWED_CIDRS. The demo ran this as `public` (NetworkGate off); it
# MUST go back to `private` for production.
MMOS_NETWORK_MODE=private
# The exact source ranges allowed to reach MM OS. Replace the placeholders with the
# REAL WireGuard subnet and office LAN CIDR(s) for this deployment — the values
# below are illustrative, not live. Keep 127.0.0.1/32 so the container's own
# healthcheck (and on-host curl) still works. Comma-separated, no spaces needed.
MMOS_ALLOWED_CIDRS=10.8.0.0/24,192.168.29.0/24,127.0.0.1/32
# Number of trusted reverse proxies in front of the app (Coolify's Traefik = 1).
# This decides how far back client_ip() reads X-Forwarded-For; too high lets a
# client spoof its source IP past the CIDR gate, so keep it exact.
MMOS_TRUSTED_PROXY_COUNT=1

# ── cookies — the second revert ─────────────────────────────────────────────
# Secure MUST be true in production: the session cookie then only ever travels over
# HTTPS. The demo may have set this false to work over plain http. Never ship
# production with it false.
MMOS_COOKIE_SECURE=true
# Cross-host SSO NOTE (product-owner decision, see handoff/c1-sso.md): services live
# on different sslip.io hosts today and MM OS gets its own domain LATER. The real
# SSO mechanism is the launch token-handoff (per-service cookie set by each service),
# which does NOT depend on a shared parent cookie domain. The .m-mines.com shared
# cookie below stays configured but DORMANT until the OS actually serves from a
# *.m-mines.com host. Until then, leave it as-is (the shell session cookie is
# host-only when this does not match the serving host) or set it to the OS's real
# domain once it exists — it is not what makes SSO work.
MMOS_COOKIE_DOMAIN=.m-mines.com

# ── Google Workspace OIDC (INT-4: docs/14-google-oidc-setup.md) ─────────────
# PIN is the only live login this phase; Google OIDC is built and tested but not the
# primary path. Fill these in once the OAuth client exists (docs/14). The redirect
# URI registered in Google Cloud must be exactly MMOS_ISSUER + the redirect path:
#   https://os.m-mines.com/api/auth/google/callback
MMOS_GOOGLE_CLIENT_ID=
MMOS_GOOGLE_CLIENT_SECRET=
MMOS_GOOGLE_HOSTED_DOMAIN=m-mines.com

# ── token signing ───────────────────────────────────────────────────────────
# Mounted FILE, never an env var: env vars leak into logs, crash reports and
# `docker inspect`. Generate a REAL key on the VPS with scripts/gen-signing-key.sh
# (the demo key, if any, must not be reused). The kid must match what jwks() serves.
MMOS_SIGNING_KEY_PATH=/run/secrets/mmos_signing_key.pem
MMOS_SIGNING_KEY_ID=mmos-2026-08
MMOS_SERVICE_TOKEN_TTL_SECONDS=900
MMOS_SESSION_TTL_HOURS=12
MMOS_REVOCATION_POLL_SECONDS=60

# ── boot behaviour ──────────────────────────────────────────────────────────
# Keep migrations an explicit operator step in production (docs/10 §1); do NOT set
# MMOS_MIGRATE_ON_BOOT / MMOS_SEED_ON_BOOT to true here — those exist for the
# unattended demo. Reseed from the real spreadsheet by hand:
#   python -m app.seed --xlsx /path/inside/container/Employee_Role_Access_Mapping.xlsx --commit
# MMOS_MIGRATE_ON_BOOT=false
# MMOS_SEED_ON_BOOT=false

# ── outbound mail (Workspace SMTP), used by Service Desk notifications ───────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=itadmin@m-mines.com
SMTP_PASSWORD=

# ── other MMOS_ settings (backend/app/config.py) — defaults shown, override only
#    if needed ───────────────────────────────────────────────────────────────
# MMOS_GOOGLE_REDIRECT_PATH=/api/auth/google/callback
# MMOS_SESSION_MAX_DAYS=7
# MMOS_CLOCK_SKEW_SECONDS=60
# MMOS_COOKIE_NAME=mmos_session
# MMOS_PIN_MAX_ATTEMPTS=5
# MMOS_PIN_LOCKOUT_MINUTES=15

# ============================================================================
# REVERT CHECKLIST — do all of these before calling the deployment "production".
# (mirrors RESUME.md "MUST be reverted after the meeting")
# ----------------------------------------------------------------------------
#  [ ] MMOS_NETWORK_MODE=private, with the REAL MMOS_ALLOWED_CIDRS above.
#  [ ] MMOS_COOKIE_SECURE=true (this file), served over HTTPS only.
#  [ ] Rotate the Coolify API token — it was sent over plain HTTP during the demo.
#  [ ] Rotate the RSA signing key if the demo key was ever exposed; real key
#      generated on the VPS via scripts/gen-signing-key.sh, mounted as a secret file.
#  [ ] Remove backend/app/demo_seed.py AND scrub it from git history (23 real
#      employee names), then reseed from the real spreadsheet. (docs/10 §16)
#  [ ] Replace every demo PIN (all were 1234) — issue real PINs (docs/10 §6).
#  [ ] deploy/postgres/init.sql per-service passwords set to real values in a
#      local, gitignored copy (RESUME.md).
#  [ ] Single worker confirmed (deploy/entrypoint.sh --workers 1) — do not scale
#      without Redis (docs/10 §16, docs/11 finding #3).
#  [ ] No host port published (deploy/docker-compose.yml uses expose, not ports);
#      confirm nothing answers on the VPS host :8000 (deploy/COOLIFY.md §6).
#  [ ] OFFSITE_DEST set so backups leave the VPS (docs/06, docs/10 §13).
# ============================================================================
