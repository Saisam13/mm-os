# ── MM OS environment. Copy to deploy/.env and fill in. ──────────────────
MMOS_ISSUER=https://os.m-mines.com
MMOS_ENVIRONMENT=production
MMOS_VERSION=1.0.0

# Database (one Postgres instance on the VPS, one database per service). Under
# deploy/docker-compose.yml the api container's MMOS_DATABASE_URL is built from
# POSTGRES_PASSWORD automatically (postgres:5432, not localhost) — the line below only
# matters when running the API directly against a local Postgres, e.g. scripts/dev.*.
MMOS_DATABASE_URL=postgresql+psycopg://mmos:CHANGE_ME@localhost:5432/mmos
POSTGRES_PASSWORD=CHANGE_ME

# Network posture: private = office LAN + WireGuard only. See docs/06-network-security.md
MMOS_NETWORK_MODE=private
MMOS_ALLOWED_CIDRS=10.8.0.0/24,192.168.29.0/24,127.0.0.1/32
MMOS_TRUSTED_PROXY_COUNT=1

# Google Workspace OIDC. Redirect URI must be registered in the Google Cloud console as
# https://os.m-mines.com/api/auth/google/callback
MMOS_GOOGLE_CLIENT_ID=
MMOS_GOOGLE_CLIENT_SECRET=
MMOS_GOOGLE_HOSTED_DOMAIN=m-mines.com

# Token signing. Mounted FILE, never an env var: env vars leak into logs and crash reports.
MMOS_SIGNING_KEY_PATH=/run/secrets/mmos_signing_key.pem
MMOS_SIGNING_KEY_ID=mmos-2026-08
MMOS_SERVICE_TOKEN_TTL_SECONDS=900
MMOS_SESSION_TTL_HOURS=12
MMOS_REVOCATION_POLL_SECONDS=60

# Cookies
MMOS_COOKIE_DOMAIN=.m-mines.com
MMOS_COOKIE_SECURE=true

# Outbound mail (Workspace SMTP), used by Service Desk notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=itadmin@m-mines.com
SMTP_PASSWORD=

# ── Additional MMOS_ settings (backend/app/config.py) ─────────────────────
# Every one of these already has the default shown below baked into Settings, so
# leaving a line commented out is identical to omitting it — uncomment only to override.
# Listed here so the full env contract is visible in one file, per the A6 brief.
# MMOS_GOOGLE_REDIRECT_PATH=/api/auth/google/callback
# MMOS_SESSION_MAX_DAYS=7
# MMOS_CLOCK_SKEW_SECONDS=60
# MMOS_COOKIE_NAME=mmos_session
# MMOS_PIN_MAX_ATTEMPTS=5
# MMOS_PIN_LOCKOUT_MINUTES=15
