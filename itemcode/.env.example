# Item Code Studio environment. Copy to itemcode/.env and fill in for a real deployment.
# Own database — never MM OS's, never servicedesk's.
DATABASE_URL=postgresql+psycopg://itemcode:CHANGE_ME@postgres:5432/itemcode

MMOS_OS_URL=https://os.m-mines.com
MMOS_SERVICE_SLUG=itemcode
MMOS_SERVICE_KEY=
MMOS_ISSUER=https://os.m-mines.com

# "http" once this service is registered with MM OS and reachable; "stub" is what every
# test in this repo runs against, and what local dev without a live MM OS uses. See
# app/mmos_seam.py. AUTH_MODE must be "http" in any production environment — app/main.py
# refuses to boot otherwise (fail closed).
AUTH_MODE=stub
DEV_SECRET=CHANGE_ME

ENVIRONMENT=development
